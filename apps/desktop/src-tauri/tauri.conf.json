{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focusly",
  "version": "0.1.0",
  "identifier": "com.focusly.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Focusly",
        "width": 420,
        "height": 780,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
