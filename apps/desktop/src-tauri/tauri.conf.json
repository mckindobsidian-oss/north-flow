{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NORTH",
  "version": "0.2.0",
  "identifier": "com.north.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NORTH",
        "width": 460,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
