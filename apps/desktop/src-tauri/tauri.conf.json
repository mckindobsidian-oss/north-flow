{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NORTH",
  "version": "0.2.0",
  "identifier": "com.north.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../react-app run dev -- --port 5175 --strictPort",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm --prefix ../../react-app run build",
    "frontendDist": "../../../react-app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": {
      "localData": "$LOCALDATA/NorthDesktop"
    },
    "windows": [
      {
        "title": "NORTH",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dataDirectory": "north-webview-v1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
