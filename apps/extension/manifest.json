
{
  "manifest_version": 3,
  "name": "NORTH Flow — Focus & Website Blocker",
  "version": "0.3.7",
  "minimum_chrome_version": "120",
  "description": "Focus sessions, scheduled website blocking and private screen-time, driven by the same block rules as the NORTH web and desktop apps.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "idle",
    "notifications",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "north-logo.png",
    "32": "north-logo.png",
    "48": "north-logo.png",
    "128": "north-logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NORTH Flow",
    "default_icon": {
      "16": "north-logo.png",
      "32": "north-logo.png",
      "48": "north-logo.png",
      "128": "north-logo.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost:5174/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:5174/*"
    ]
  }
}
