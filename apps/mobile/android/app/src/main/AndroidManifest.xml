      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/north_browser_accessibility"/>
    </service>
    <service android:name="com.north.device.NorthMonitorService" android:exported="false" android:foregroundServiceType="specialUse">
